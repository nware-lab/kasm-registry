{
  "description": "Rustdesk",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "rustdesk.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity"
  ],
  "friendly_name": "Rustdesk",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "nwarelab/kasm-rustdesk:latest",
      "uncompressed_size_mb": 1170,
      "available_tags": [
        "develop",
        "1.18.0"
      ]
    }
  ]
}
